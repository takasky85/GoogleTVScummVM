+// TV build: make a real mouse faster than Android's pointer speed allows. Android sends absolute
+// pointer positions, so the movement since the previous event is multiplied and added to a virtual
+// position that is kept inside the game's drawing area.
+void OSystem_Android::applyMouseSpeed(int &x, int &y) {
+	if (_mouseSpeed <= 100) {
+		_mouseHaveRaw = false;
+		return;
+	}
+
+	AndroidGraphicsManager *gm = dynamic_cast<AndroidGraphicsManager *>(_graphicsManager);
+	if (!gm) {
+		return;
+	}
+
+	if (!_mouseHaveRaw) {
+		_mouseHaveRaw = true;
+		_mouseRawX = x;
+		_mouseRawY = y;
+		_mouseVirtX100 = x * 100;
+		_mouseVirtY100 = y * 100;
+		return;
+	}
+
+	_mouseVirtX100 += (x - _mouseRawX) * _mouseSpeed;
+	_mouseVirtY100 += (y - _mouseRawY) * _mouseSpeed;
+	_mouseRawX = x;
+	_mouseRawY = y;
+
+	Common::Rect r = gm->getActiveDrawRect();
+	if (r.width() > 0 && r.height() > 0) {
+		_mouseVirtX100 = CLIP<int>(_mouseVirtX100, r.left * 100, r.right * 100);
+		_mouseVirtY100 = CLIP<int>(_mouseVirtY100, r.top * 100, r.bottom * 100);
+	}
+
+	x = _mouseVirtX100 / 100;
+	y = _mouseVirtY100 / 100;
+}
