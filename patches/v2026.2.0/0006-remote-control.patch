+// TV build: moves the cursor while a remote arrow is held. The speed starts slow for precise
+// aiming and speeds up the longer the button is held. Runs on the main thread.
+void OSystem_Android::updateRemoteCursor() {
+	if (!_remoteHeld) {
+		_remoteLastMs = 0;
+		return;
+	}
+
+	uint32 now = getMillis(true);
+	// safety: Android repeats a held key about every 50 ms after a short delay, so a long silence
+	// means that we missed the key release
+	if (now - _remoteKeyMs > 2500) {
+		_remoteHeld = 0;
+		_remoteLastMs = 0;
+		return;
+	}
+
+	AndroidGraphicsManager *gm = dynamic_cast<AndroidGraphicsManager *>(_graphicsManager);
+	if (!gm) {
+		return;
+	}
+
+	if (_remoteLastMs == 0) {
+		_remoteLastMs = now;
+		_remoteStartMs = now;
+		_remoteAccX = _remoteAccY = 0.0f;
+	}
+
+	uint32 dt = now - _remoteLastMs;
+	if (dt < 10) {
+		return;
+	}
+	_remoteLastMs = now;
+
+	Common::Rect r = gm->getActiveDrawRect();
+	float span = r.width() > 0 ? (float)r.width() : 1280.0f;
+
+	float ramp = (float)(now - _remoteStartMs) / 1500.0f;
+	if (ramp > 1.0f) {
+		ramp = 1.0f;
+	}
+	// pixels per second: 15% of the screen width at first, up to about 90% after 1.5 seconds
+	float pps = span * (0.15f + 0.75f * ramp * ramp);
+
+	int held = _remoteHeld;
+	float dx = ((held & 8) ? 1.0f : 0.0f) - ((held & 4) ? 1.0f : 0.0f);
+	float dy = ((held & 2) ? 1.0f : 0.0f) - ((held & 1) ? 1.0f : 0.0f);
+	_remoteAccX += dx * pps * dt / 1000.0f;
+	_remoteAccY += dy * pps * dt / 1000.0f;
+
+	int mx = (int)_remoteAccX;
+	int my = (int)_remoteAccY;
+	if (mx == 0 && my == 0) {
+		return;
+	}
+	_remoteAccX -= mx;
+	_remoteAccY -= my;
+
+	Common::Event ev;
+	ev.type = Common::EVENT_MOUSEMOVE;
+	ev.mouse = gm->getMousePosition();
+	ev.mouse.x += mx;
+	ev.mouse.y += my;
+	pushEvent(ev);
+}
